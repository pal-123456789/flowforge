{
  "id": "seed_sentiment-router",
  "name": "AI Sentiment → Smart Routing",
  "description": "Classify incoming feedback sentiment with the AI node, then branch: happy customers get a thank-you, unhappy ones escalate.",
  "tags": [
    "ai",
    "branching",
    "support"
  ],
  "nodes": [
    {
      "id": "n1",
      "type": "flowNode",
      "position": {
        "x": 40,
        "y": 220
      },
      "data": {
        "type": "trigger.manual",
        "label": "Manual Trigger",
        "config": {
          "payload": "{\n  \"customer\": \"Sam\",\n  \"message\": \"This product is amazing, I love the fast support!\"\n}"
        }
      }
    },
    {
      "id": "n2",
      "type": "flowNode",
      "position": {
        "x": 320,
        "y": 220
      },
      "data": {
        "type": "ai.generate",
        "label": "AI",
        "config": {
          "prompt": "Classify sentiment: {{message}}",
          "mode": "sentiment",
          "outputKey": "sentiment"
        }
      }
    },
    {
      "id": "n3",
      "type": "flowNode",
      "position": {
        "x": 620,
        "y": 220
      },
      "data": {
        "type": "logic.if",
        "label": "If",
        "config": {
          "left": "{{sentiment}}",
          "operator": "contains",
          "right": "positive"
        }
      }
    },
    {
      "id": "n4",
      "type": "flowNode",
      "position": {
        "x": 940,
        "y": 100
      },
      "data": {
        "type": "action.email",
        "label": "Send Email",
        "config": {
          "to": "{{customer}}",
          "subject": "Thank you!",
          "body": "Hi {{customer}}, thanks so much for the kind words!"
        }
      }
    },
    {
      "id": "n5",
      "type": "flowNode",
      "position": {
        "x": 940,
        "y": 340
      },
      "data": {
        "type": "action.log",
        "label": "Log",
        "config": {
          "message": "Escalating unhappy customer {{customer}}: {{message}}",
          "level": "warn"
        }
      }
    }
  ],
